---
// /legal/privacy /legal/terms /legal/cookies /legal/company: nfb-legal DRAFTS (advokat review pending); noindex while draft.
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/LegalPage.astro';
import { getContent, type LegalKey } from '@nf/content';
import { LEGAL_KEYS } from '../../lib/site.ts';

export function getStaticPaths() {
  return LEGAL_KEYS.map((page) => ({ params: { page } }));
}
const key = Astro.params.page as LegalKey;
const page = getContent('en').legal[key];
---
<Base title={page.meta.title} description={page.meta.description} noindex={page.draft} locale="en">
  <LegalPage locale="en" page={key} />
</Base>
