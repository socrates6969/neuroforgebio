{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nf:schema:pipeline-version:v1",
  "title": "NeuroForge PipelineVersion v1",
  "description": "A PipelineVersion document (BUILD-GUIDE 3.2, BLUEPRINT 3.5). Its ID is pv:sha256:<hex> = SHA-256('nf.pipeline-version.v1' 0x00 NF-CJSON(document without 'meta')), docs/spec/hashing.md 5.1. Published versions are immutable. Every parameter is explicit (library defaults are filled in before hashing). Reference implementation: services/platform/nf_platform/pipelines/spec.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meta", "steps", "seed"],
  "properties": {
    "schema": { "const": "nf.pipeline-version/v1" },
    "meta": {
      "description": "Label and description. NOT hashed: renaming does not change the ID.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "version": {
          "description": "Semantic version (semver.org 2.0.0).",
          "type": "string",
          "maxLength": 100,
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "description": { "type": "string", "maxLength": 2000 }
      }
    },
    "steps": {
      "description": "Ordered steps. Step names are unique (checked by the reference implementation; JSON Schema cannot express uniqueness of a member).",
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/step" }
    },
    "seed": {
      "description": "Seed for every random choice of the pipeline (determinism, BLUEPRINT 3.5).",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "entrypoint", "params", "tolerance"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$" },
        "step": {
          "description": "Step-library reference name@version (optional).",
          "type": "string",
          "maxLength": 200,
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}@[0-9A-Za-z.+-]+$"
        },
        "image": {
          "description": "Container image pinned by digest; tags (e.g. :latest) are rejected.",
          "type": "string",
          "maxLength": 500,
          "pattern": "^(?:[a-zA-Z0-9.-]+(?::[0-9]+)?/)?[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$"
        },
        "entrypoint": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "params": {
          "description": "Every parameter, explicit, including defaults. Values are NF-CJSON (no NaN/Infinity; integers within +-(2^53-1)).",
          "type": "object"
        },
        "tolerance": { "$ref": "#/$defs/tolerance" }
      }
    },
    "tolerance": {
      "description": "Declared reproducibility class: 'exact' = byte-identical outputs; 'abs'/'rel' = numerically equal within value.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "exact" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["abs", "rel"] },
            "value": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    }
  }
}
