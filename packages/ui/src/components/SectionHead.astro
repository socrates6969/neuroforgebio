---
// Section heading block: eyebrow label, Rich heading (<em> only), lede. Optional ornament slot.
interface Props { eyebrow: string; heading: string; lede?: string; id: string; level?: 1 | 2 }
const { eyebrow, heading, lede, id, level = 2 } = Astro.props;
const H = level === 1 ? 'h1' : 'h2';
---
<div class="sec-head">
  <p class="nf-label"><slot name="ornament" />{eyebrow}</p>
  <div>
    <H id={id} set:html={heading} />
    {lede && <p class="nf-lede">{lede}</p>}
  </div>
</div>
<style>
  .sec-head { display: grid; grid-template-columns: 220px 1fr; gap: 32px; margin-bottom: 48px; }
  .sec-head .nf-lede { margin-top: 14px; }
  @media (max-width: 800px) { .sec-head { grid-template-columns: 1fr; gap: 12px; } }
</style>
