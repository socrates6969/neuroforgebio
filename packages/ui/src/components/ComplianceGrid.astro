---
// Compliance/security controls with their status. The theme's SecurityVisual goes in the "visual" slot.
// Rows have 2 columns (control, status) or 3 (control, description, status). A row may carry several
// statuses, each with an optional qualifier: [{status:'planned'}, {status:'roadmap', note:'EU'}]
// renders "Planned / Roadmap (EU)". *Html fields are pre-rendered by a safe inline renderer (set:html).
import type { Status, StatusLabels } from '../types.ts';
import StatusPill from './StatusPill.astro';
interface StatusRef { status: Status; note?: string }
interface Row {
  control?: string; controlHtml?: string;
  description?: string; descriptionHtml?: string;
  status: Status | StatusRef[];
  source?: string;
}
interface Props { rows: Row[]; caption?: string; legal?: string; statusLabels: StatusLabels; statusPrefix?: string; headers?: string[]; labelledBy?: string }
const { rows, caption, legal, statusLabels, statusPrefix, headers, labelledBy } = Astro.props;
const refs = (s: Row['status']): StatusRef[] => (typeof s === 'string' ? [{ status: s }] : s);
const label = (r: StatusRef) => (r.note ? `${statusLabels[r.status]} (${r.note})` : statusLabels[r.status]);
const hasDesc = rows.some((r) => r.description || r.descriptionHtml);
---
<div class="grid-wrap">
  <slot name="visual" />
  <table class:list={['specs', { 'two-col': !hasDesc }]} aria-labelledby={labelledBy}>
    {caption && <caption class="nf-label">{caption}</caption>}
    {headers && <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>}
    <tbody>
      {rows.map((r) => (
        <tr>
          {r.controlHtml ? <th scope="row" set:html={r.controlHtml} /> : <th scope="row">{r.control}</th>}
          {hasDesc && (r.descriptionHtml
            ? <td class="desc"><Fragment set:html={r.descriptionHtml} />{r.source && <small class="src">{r.source}</small>}</td>
            : <td class="desc">{r.description}{r.source && <small class="src">{r.source}</small>}</td>)}
          <td class="st">
            {refs(r.status).map((s, i) => (
              <>{i > 0 && <span class="sep" aria-hidden="true"> / </span>}<StatusPill status={s.status} label={label(s)} prefix={statusPrefix} /></>
            ))}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
  {legal && <p class="legal">{legal}</p>}
</div>
<style>
  .specs { width: 100%; border-collapse: collapse; background: var(--color-surface); border: 1px solid var(--color-line); font-size: 15px; }
  caption { caption-side: bottom; text-align: left; padding-top: 12px; }
  th, td { text-align: left; padding: 15px 18px; border-top: 1px solid var(--color-line); vertical-align: top; }
  thead th { border-top: 0; font: 500 11px var(--font-mono); letter-spacing: .1em; text-transform: uppercase; color: var(--color-muted); }
  tbody th { font-weight: 500; width: 28%; }
  .two-col tbody th { width: auto; }
  td { color: var(--color-muted); }
  td.st { white-space: nowrap; }
  .sep { color: var(--color-muted); }
  .src { display: block; margin-top: 6px; font: 400 12px/1.4 var(--font-mono); }
  .legal { margin-top: 16px; font-size: 13px; color: var(--color-muted); }
  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: grid; grid-template-columns: 1fr auto; border-top: 1px solid var(--color-line); }
    tr:first-child { border-top: 0; }
    th, td { border-top: 0; }
    tbody th { width: auto; padding-bottom: 4px; }
    td.desc { grid-column: 1 / -1; grid-row: 2; padding-top: 0; }
    td.st { grid-column: 2; grid-row: 1; white-space: normal; }
  }
</style>
