---
// Language switch: links ONLY to pages that exist in the other language (the caller passes them).
// Each link names the language in that language, with lang + hreflang, so screen readers pronounce it.
interface LangLink { href: string; hreflang: string; lang: string; name: string }
interface Props { label: string; links: LangLink[] }
const { label, links } = Astro.props;
---
{links.length > 0 && (
  <nav class="nf-lang" aria-label={label}>
    <ul>
      {links.map((l) => <li><a href={l.href} hreflang={l.hreflang} lang={l.lang}>{l.name}</a></li>)}
    </ul>
  </nav>
)}
<style>
  .nf-lang ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 12px; }
  .nf-lang a { font: 500 13px var(--font-mono); color: var(--color-muted); text-decoration: none; border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: 6px 10px; display: inline-block; }
  .nf-lang a:hover { color: var(--color-ink); text-decoration: underline; }
</style>
