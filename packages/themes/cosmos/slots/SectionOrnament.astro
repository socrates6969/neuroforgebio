---
// Cosmos SectionOrnament: a small orbit ring with a glowing satellite before the section eyebrow,
// plus the section number as CSS generated content (so both themes render identical HTML text).
// Decorative and aria-hidden; the orbit stops under prefers-reduced-motion.
import type { SlotContract } from '../../contract.ts';
type Props = SlotContract['SectionOrnament'];
const { index } = Astro.props;
const n = typeof index === 'number' && index > 0 ? String(index).padStart(2, '0') : undefined;
---

<span class="nf-so" data-n={n} aria-hidden="true">
  <svg width="22" height="22" viewBox="0 0 22 22" focusable="false">
    <ellipse class="ring" cx="11" cy="11" rx="9.5" ry="9.5"></ellipse>
    <g class="orbit"><circle class="sat" cx="20.5" cy="11" r="2"></circle></g>
    <circle class="core" cx="11" cy="11" r="2.4"></circle>
  </svg>
</span>

<style>
  .nf-so {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-right: 10px;
    vertical-align: middle;
    font: 500 11.5px/1 var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--color-secondary);
  }
  .nf-so[data-n]::after {
    content: attr(data-n);
  }
  .nf-so svg {
    display: block;
    overflow: visible;
  }
  .ring {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 1;
    stroke-dasharray: 2 3;
  }
  .core {
    fill: var(--color-accent);
    filter: drop-shadow(0 0 4px var(--color-accent));
  }
  .sat {
    fill: var(--color-secondary);
    filter: drop-shadow(0 0 3px var(--color-secondary));
  }
  .orbit {
    transform-origin: 11px 11px;
    animation: nf-so-orbit 9s linear infinite;
  }
  @keyframes nf-so-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .orbit {
      animation: none;
      transform: rotate(-40deg);
    }
  }
</style>
