<Project Sdk="Microsoft.NET.Sdk">
  <!-- xUnit tests of the Unity package's runtime against the REAL native library built from
       bindings/c. Environment:
         NF_NATIVE_DIR   directory holding neuroforge.dll (default: <repo>/target/debug)
         NF_FIXTURE_DIR  output of `cargo run -p neuroforge-c --example make_fixture -- <dir>`
       See ../README.md. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- one test class at a time: the leak tests measure process memory -->
    <ParallelizeTestCollections>false</ParallelizeTestCollections>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../NeuroForge.Runtime/NeuroForge.Runtime.csproj" />
  </ItemGroup>
</Project>
